#!/bin/sh
# Entware init: S99keengen — static UI + local API (mipsel binary).
ENABLED=yes
DESC="keengen Entware UI"

CONF=/opt/etc/keengen/keengen.conf
BIN=/opt/sbin/keengen-httpd
PID=/opt/var/run/keengen-httpd.pid

# Strip CR so CRLF conf (Windows-built IPK) does not break [ -d "$KEENGEN_WWW" ].
if [ -f "$CONF" ]; then
	if command -v tr >/dev/null 2>&1; then
		eval "$(tr -d '\r' < "$CONF")"
	elif command -v sed >/dev/null 2>&1; then
		eval "$(sed 's/\r$//' "$CONF")"
	else
		# shellcheck disable=SC1090
		. "$CONF"
	fi
fi
KEENGEN_BIND=${KEENGEN_BIND:-0.0.0.0}
KEENGEN_PORT=${KEENGEN_PORT:-1001}
KEENGEN_WWW=${KEENGEN_WWW:-/opt/share/keengen/www}

start() {
	if [ ! -x "$BIN" ]; then
		echo "keengen: missing $BIN" >&2
		return 1
	fi
	if [ ! -d "$KEENGEN_WWW" ]; then
		echo "keengen: missing $KEENGEN_WWW" >&2
		return 1
	fi
	mkdir -p /opt/var/run
	if [ -f "$PID" ] && kill -0 "$(cat "$PID")" 2>/dev/null; then
		echo "keengen: already running"
		return 0
	fi
	KEENGEN_BIND="$KEENGEN_BIND" KEENGEN_PORT="$KEENGEN_PORT" KEENGEN_WWW="$KEENGEN_WWW" \
		"$BIN" -bind "$KEENGEN_BIND" -port "$KEENGEN_PORT" -www "$KEENGEN_WWW" >/opt/var/log/keengen.log 2>&1 &
	echo $! >"$PID"
	echo "keengen UI http://${KEENGEN_BIND}:${KEENGEN_PORT}/"
}

stop() {
	if [ -f "$PID" ]; then
		kill "$(cat "$PID")" 2>/dev/null || true
		rm -f "$PID"
	fi
	killall keengen-httpd 2>/dev/null || true
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart) stop; start ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
