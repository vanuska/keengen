#!/bin/sh
# Entware init: S99keengen — static UI only (scaffold).
ENABLED=yes
PROCS=httpd
DESC="keengen static UI"

CONF=/opt/etc/keengen/keengen.conf
PID=/opt/var/run/keengen-httpd.pid

[ -f "$CONF" ] && . "$CONF"
KEENGEN_BIND=${KEENGEN_BIND:-0.0.0.0}
KEENGEN_PORT=${KEENGEN_PORT:-1001}
KEENGEN_WWW=${KEENGEN_WWW:-/opt/share/keengen/www}

start() {
	if [ ! -d "$KEENGEN_WWW" ]; then
		echo "keengen: missing $KEENGEN_WWW" >&2
		return 1
	fi
	if ! command -v httpd >/dev/null 2>&1; then
		echo "keengen: busybox httpd not found; install busybox or replace with helper binary" >&2
		return 1
	fi
	mkdir -p /opt/var/run
	# busybox httpd: -p [ADDR:]PORT -h DOCROOT -f foreground avoided
	httpd -p "${KEENGEN_BIND}:${KEENGEN_PORT}" -h "$KEENGEN_WWW" -r "keengen"
	echo "keengen UI http://${KEENGEN_BIND}:${KEENGEN_PORT}/"
}

stop() {
	# best-effort: kill httpd whose cwd/docroot is ours (scaffold)
	killall httpd 2>/dev/null || true
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart) stop; start ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
